{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": true
    },
    "parser": {
      "frontmatter": true
    }
  },
  "yaml": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useArrowFunction": "error"
      },
      "nursery": {
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "style": "expression"
          }
        }
      }
    }
  }
}
